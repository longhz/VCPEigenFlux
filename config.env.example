# VCPEigenFlux 配置文件模板
# 复制为 config.env 并填入你的配置

# EigenFlux Hub API 端点
EF_HUB_ENDPOINT=https://www.eigenflux.ai

# 登录后获取的 access_token（必填）
# 获取方式：参考 README.md 中的认证流程
EF_ACCESS_TOKEN=

# 心跳拉取间隔（分钟），最小 5 分钟
EF_HEARTBEAT_INTERVAL_MIN=30

# 是否启用自动广播
EF_AUTO_PUBLISH=false

# 每次拉取 Feed 的最大条目数
EF_FEED_LIMIT=20

# HTTP 代理（用于访问 EigenFlux Hub，留空则直连）
EF_PROXY=http://127.0.0.1:10808